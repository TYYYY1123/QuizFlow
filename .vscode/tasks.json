{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run QuizFlow",
            "type": "shell",
            "command": "gcc main.c -o main.exe; if ($LASTEXITCODE -eq 0) { .\\main.exe }",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-Command"
                    ]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}